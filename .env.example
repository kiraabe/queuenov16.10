# Database
DATABASE_URL=postgresql://user:password@host:port/database

# Authentication
AUTH_SECRET=your-auth-secret-key

# External APIs
WELLSAIDLABS_API_KEY=your-wellsaid-labs-api-key

# Security
FORCE_STRICT_ORIGIN=true

# Licensing
LICENSE_HOST=stc.example.org
LICENSE_STATE_DIR=/var/lib/stc/license
LICENSE_GRACE_PERIOD_DAYS=30
LICENSE_ISSUER_ENABLED=false
LICENSE_SIGNING_KEY_ID=
LICENSE_SIGNING_PRIVATE_KEY=
LICENSE_TRUSTED_PUBLIC_KEYS={}
LICENSE_LEGACY_ISSUANCE_ENABLED=false

# Supabase (Public)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase (Private - server only)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
